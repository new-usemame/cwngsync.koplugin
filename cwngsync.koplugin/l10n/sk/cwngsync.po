#: main.lua:690
msgid "%1 is not a server address. Type it like books.example.com or http://192.168.1.20:8083."
msgstr "%1 nie je adresa servera. Zadajte ju napríklad ako books.example.com alebo http://192.168.1.20:8083."

#: main.lua:742
msgid "Cannot login: %1"
msgstr "Nedá sa prihlásiť: %1"

#: main.lua:755
msgid "Logging in. Please wait…"
msgstr "Prihlasujem. Čakajte, prosím…"

#: main.lua:782
msgid "An error occurred while logging in:"
msgstr "Pri prihlasovaní nastala chyba:"

#: main.lua:787
msgid "An unknown error occurred while logging in."
msgstr "Pri prihlasovaní nastala neznáma chyba."

#: main.lua:799
msgid "Logged in to NextGen server."
msgstr "Prihlásené na server NextGen."

#: main.lua:803
msgid "Unknown server error"
msgstr "Neznáma chyba servera"

#: main.lua:1164
msgid "Please login before reporting this device's library."
msgstr "Pred nahlásením knižnice tohto zariadenia sa prihláste."

#: main.lua:1203
msgid "Device library reported: %1 books, %2 matched."
msgstr "Knižnica zariadenia nahlásená: kníh %1, spárovaných %2."

#: main.lua:1213
msgid "Device library report failed: %1"
msgstr "Nahlásenie knižnice zariadenia zlyhalo: %1"

#: main.lua:1213 main.lua:1487 main.lua:1554 main.lua:1584
msgid "unknown error"
msgstr "neznáma chyba"

#: main.lua:1456
msgid "Choose a device library folder before collecting queued books."
