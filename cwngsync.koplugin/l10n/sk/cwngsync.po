#: main.lua:2520
msgid "Highlights synced: %1 to device, %2 to server."
msgstr "Zvýraznenia synchronizované: %1 do zariadenia, %2 na server."

#: main.lua:2532
msgid "Highlights synced: %1 to device. Server push failed: %2"
msgstr "Zvýraznenia synchronizované: %1 do zariadenia. Odoslanie na server zlyhalo: %2"

#: main.lua:2533
msgid "Highlights synced: %1 to device. Server push failed."
msgstr "Zvýraznenia synchronizované: %1 do zariadenia. Odoslanie na server zlyhalo."

#: main.lua:2541
msgid "Highlights synced: %1 to device."
msgstr "Zvýraznenia synchronizované: %1 do zariadenia."
