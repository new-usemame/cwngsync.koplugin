msgid "No books are queued for this device."
msgstr "Pre toto zariadenie nie sú zaradené žiadne knihy."

#: main.lua:1553
msgid "Queued book could not be installed: %1"
msgstr "Zaradenú knihu sa nepodarilo nainštalovať: %1"

#: main.lua:1583
msgid "Book installed, but confirmation failed: %1"
msgstr "Kniha bola nainštalovaná, ale potvrdenie zlyhalo: %1"

#: main.lua:1605
msgid "Collected %1 queued books."
msgstr "Prevzaté zaradené knihy: %1."

#: main.lua:1771
msgid "No supported books were found under %1."
msgstr "V %1 sa nenašli žiadne podporované knihy."

#: main.lua:1772
msgid "No books were found in the current library view."
msgstr "V aktuálnom zobrazení knižnice sa nenašli žiadne knihy."

#: main.lua:1803
msgid "Library sync finished. Remote progress: %1, changed: %2, no remote progress: %3, failed: %4."
msgstr "Synchronizácia knižnice dokončená. Vzdialený postup: %1, zmenené: %2, bez vzdialeného postupu: %3, zlyhané: %4."

#: main.lua:1968 main.lua:2087
msgid "Unable to compute document checksum for this book."
msgstr "Pre túto knihu sa nepodarilo vypočítať kontrolný súčet dokumentu."

#: main.lua:1999 main.lua:2333
msgid "Progress has been pushed."
msgstr "Postup bol odoslaný."

#: main.lua:2051
msgid "No book is currently open. Pull progress for all books under %1?"
msgstr "Nie je otvorená žiadna kniha. Načítať postup pre všetky knihy v %1?"

#: main.lua:2052
msgid "No book is currently open. Pull progress for all books in the current library view?"
msgstr "Nie je otvorená žiadna kniha. Načítať postup pre všetky knihy v aktuálnom zobrazení knižnice?"

#: main.lua:2138
msgid "No progress found for this document."
msgstr "Pre tento dokument sa nenašiel žiadny postup."

#: main.lua:2168
msgid "The progress has already been synchronized."
msgstr "Postup už bol synchronizovaný."

#: main.lua:2183
msgid "The latest position on the server, %1%, was saved from this device. Go to it?"
msgstr "Najnovšia pozícia na serveri, %1 %, bola uložená z tohto zariadenia. Prejsť na ňu?"

#: main.lua:2225
msgid "Sync to latest location %1% from device '%2'?"
msgstr "Synchronizovať na najnovšiu pozíciu %1 % zo zariadenia „%2“?"

#: main.lua:2241
msgid "Sync to previous location %1% from device '%2'?"
msgstr "Synchronizovať na predchádzajúcu pozíciu %1 % zo zariadenia „%2“?"

