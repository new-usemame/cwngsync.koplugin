#: cwng_pairing_screen.lua:42
msgid "Connect to your library"
msgstr "Pripojiť ku knižnici"

#: cwng_pairing_screen.lua:50
msgid ""
"Scan this with your phone's camera and tap Approve.\n"
"\n"
"Or open %1 and enter:"
msgstr ""
"Naskenujte tento kód fotoaparátom telefónu a ťuknite na Schváliť.\n"
"\n"
"Alebo otvorte %1 a zadajte:"

#: cwng_pairing_screen.lua:64
msgid "This screen continues by itself once you approve."
msgstr "Po schválení bude táto obrazovka pokračovať sama."

#: cwng_setup_flow.lua:121
msgid ""
"Connected to %1.\n"
"\n"
"Your library is being added now. Covers appear as they arrive; tap any book to read it."
msgstr ""
"Pripojené k %1.\n"
"\n"
"Vaša knižnica sa práve pridáva. Obálky sa zobrazia postupne; ťuknutím na ľubovoľnú knihu ju začnete čítať."

#: cwng_setup_flow.lua:153
msgid "The setup file inside the CWNG plugin could not be used. Connect with a code instead: Tools ▸ CWNG library ▸ Connect this device."
msgstr "Konfiguračný súbor v plugine CWNG sa nedal použiť. Namiesto toho sa pripojte pomocou kódu: Nástroje ▸ Knižnica CWNG ▸ Pripojiť toto zariadenie."

#: cwng_setup_flow.lua:174
msgid "This ready-made plugin's sign-in was switched off on the website. Download a new one, or connect with a code: Tools ▸ CWNG library ▸ Connect this device."
msgstr "Prihlásenie tohto predpripraveného pluginu bolo na webe vypnuté. Stiahnite si nový alebo sa pripojte pomocou kódu: Nástroje ▸ Knižnica CWNG ▸ Pripojiť toto zariadenie."

#: cwng_setup_flow.lua:198
msgid ""
"Read your CWNG library on this device.\n"
"\n"
"Choose how to connect:"
msgstr ""
"Čítajte svoju knižnicu CWNG v tomto zariadení.\n"
"\n"
"Zvoľte spôsob pripojenia:"

#: cwng_setup_flow.lua:202
msgid "Connect with a code (easiest)"
msgstr "Pripojiť pomocou kódu (najjednoduchšie)"

#: cwng_setup_flow.lua:209
msgid "Sign in with username and password"
msgstr "Prihlásiť sa menom a heslom"

#: cwng_setup_flow.lua:223
msgid "That username or password was not accepted. Try again from Tools ▸ CWNG library ▸ Connect this device."
msgstr "Toto používateľské meno alebo heslo nebolo prijaté. Skúste to znova cez Nástroje ▸ Knižnica CWNG ▸ Pripojiť toto zariadenie."

#: cwng_setup_flow.lua:224
msgid "Could not reach %1. Check the address and that this device is on Wi-Fi."
msgstr "%1 je nedostupný. Skontrolujte adresu a či je toto zariadenie pripojené k Wi-Fi."

#: cwng_setup_flow.lua:234
msgid "Not now"
msgstr "Teraz nie"

#: cwng_setup_flow.lua:238
msgid "Don't ask again"
msgstr "Už sa nepýtať"

#: cwng_setup_flow.lua:253
msgid "Your CWNG address"
msgstr "Vaša adresa CWNG"

#: cwng_setup_flow.lua:254
msgid "The address you open CWNG at in a browser, for example books.example.com or 192.168.1.20:8083."
msgstr "Adresa, na ktorej otvárate CWNG v prehliadači, napríklad books.example.com alebo 192.168.1.20:8083."

#: cwng_setup_flow.lua:266
msgid "Continue"
msgstr "Pokračovať"

#: cwng_setup_flow.lua:273
msgid "That doesn't look like a web address. Type it the way you would in a browser."
msgstr "Toto nevyzerá ako webová adresa. Zadajte ju tak, ako by ste ju zadali v prehliadači."

#: cwng_setup_flow.lua:318
msgid "%1 cannot approve devices by code yet. Choose Sign in with username and password instead."
msgstr "%1 zatiaľ nevie schvaľovať zariadenia pomocou kódu. Zvoľte radšej Prihlásiť sa menom a heslom."

#: cwng_setup_flow.lua:321
msgid "%1 did not accept a pairing request. If that is your CWNG address, it may be too old to pair by code: choose Sign in with username and password instead."
msgstr "%1 neprijal žiadosť o spárovanie. Ak je to vaša adresa CWNG, môže byť príliš stará na párovanie kódom: zvoľte radšej Prihlásiť sa menom a heslom."

#: cwng_setup_flow.lua:330
msgid ""
"Could not start pairing with %1: %2\n"
"\n"
"Check the address, and that KOReader sync is switched on in CWNG's settings."
msgstr ""
"Párovanie s %1 sa nepodarilo spustiť: %2\n"
"\n"
"Skontrolujte adresu a či je v nastaveniach CWNG zapnutá synchronizácia KOReader."

#: cwng_setup_flow.lua:361
msgid "Lost contact with %1 while waiting for approval. Choose Connect this device to try again."
msgstr "Počas čakania na schválenie sa stratilo spojenie s %1. Skúste to znova cez Pripojiť toto zariadenie."

#: cwng_setup_flow.lua:363 cwng_setup_flow.lua:383
msgid "The code expired. Choose Connect this device to get a new one."
msgstr "Platnosť kódu vypršala. Nový získate cez Pripojiť toto zariadenie."

#: cwng_setup_flow.lua:374
msgid "Approved, but signing in failed. Try Connect this device again."
msgstr "Schválené, ale prihlásenie zlyhalo. Skúste znova Pripojiť toto zariadenie."

#: cwng_setup_flow.lua:380
msgid "The request was declined on the website."
msgstr "Žiadosť bola na webe zamietnutá."

#: cwng_setup_flow.lua:406
msgid "This device is disconnected from CWNG. Your downloaded books stay on it."
msgstr "Toto zariadenie je odpojené od CWNG. Stiahnuté knihy v ňom zostávajú."

#: main.lua:48
msgid "Login to NextGen Server"
msgstr "Prihlásenie na server NextGen"

#: main.lua:133
msgid "KOReader's settings on this e-reader were copied from another device, including its sync ID. This e-reader now has its own ID, so the server lists it as a separate device."
msgstr "Nastavenia KOReadera v tejto čítačke boli skopírované z iného zariadenia vrátane synchronizačného ID. Táto čítačka má teraz vlastné ID, takže ju server vedie ako samostatné zariadenie."

#: main.lua:188
msgid "Not available"
msgstr "Nedostupné"

#: main.lua:195 main.lua:566 main.lua:600
msgid "Never"
msgstr "Nikdy"

#: main.lua:201 main.lua:557 main.lua:591
msgid "Prompt"
msgstr "Opýtať sa"

#: main.lua:203
msgid "Auto"
msgstr "Automaticky"

#: main.lua:205
msgid "Disable"
msgstr "Vypnúť"

#: main.lua:211
msgid "Progress has been synchronized."
msgstr "Postup bol synchronizovaný."

#: main.lua:218
msgid "Please login before using the progress synchronization feature."
msgstr "Pred použitím synchronizácie postupu sa prihláste."

#: main.lua:225
msgid "Something went wrong when syncing progress, please check your network connection and try again later."
msgstr "Pri synchronizácii postupu sa niečo pokazilo. Skontrolujte sieťové pripojenie a skúste to neskôr."

#: main.lua:242
msgid "No book is currently open to push progress for."
msgstr "Nie je otvorená žiadna kniha, ktorej postup by sa dal odoslať."

#: main.lua:252
msgid "Please set the NextGen Server address first."
msgstr "Najprv nastavte adresu servera NextGen."

#: main.lua:271
msgid "invalid username and password"
msgstr "neplatné používateľské meno a heslo"

#: main.lua:273
msgid "invalid username"
msgstr "neplatné používateľské meno"

#: main.lua:275
msgid "invalid password"
msgstr "neplatné heslo"

#: main.lua:286
msgid "Sync with CWNG now"
msgstr "Synchronizovať s CWNG teraz"

#: main.lua:287
msgid "Push progress from this device"
msgstr "Odoslať postup z tohto zariadenia"

#: main.lua:288
msgid "Pull progress from other devices"
msgstr "Načítať postup z iných zariadení"

#: main.lua:324
msgid "CWNG library"
msgstr "Knižnica CWNG"

#: main.lua:330
msgid "Connected: %1 at %2"
msgstr "Pripojené: %1 na %2"

#: main.lua:332
msgid "Connect this device"
msgstr "Pripojiť toto zariadenie"

#: main.lua:338
msgid ""
"This device reads the CWNG library of %1 at %2.\n"
"\n"
"To use another account, choose Disconnect this device first."
msgstr ""
"Toto zariadenie číta knižnicu CWNG používateľa %1 na %2.\n"
"\n"
"Ak chcete použiť iný účet, najprv zvoľte Odpojiť toto zariadenie."

#: main.lua:355
msgid "Show my library"
msgstr "Zobraziť moju knižnicu"

#: main.lua:363
msgid "Show my CWNG library on this device"
msgstr "Zobraziť moju knižnicu CWNG v tomto zariadení"

#: main.lua:364
msgid "Every book in your CWNG library appears here with its cover, or only the books on the shelves you chose for e-readers on the website (the same choice your Kobo uses). Tap a book to download and open it."
msgstr "Zobrazí sa tu každá kniha z vašej knižnice CWNG s obálkou, alebo len knihy z políc, ktoré ste na webe vybrali pre čítačky (rovnaký výber, aký používa váš Kobo). Ťuknutím na knihu ju stiahnete a otvoríte."

#: main.lua:382
msgid "Sync reading automatically"
msgstr "Synchronizovať čítanie automaticky"

#: main.lua:383
msgid "Your position, read status and highlights are sent when you close a book or the device sleeps, and brought in whenever the device is online. Wi-Fi is never turned on for this; anything waiting goes the next time it is."
msgstr "Vaša pozícia, stav prečítania a zvýraznenia sa odošlú, keď zatvoríte knihu alebo zariadenie prejde do spánku, a načítajú sa vždy, keď je zariadenie online. Wi-Fi sa kvôli tomu nikdy nezapína; čo čaká, sa odošle pri najbližšom pripojení."

#: main.lua:403
msgid "Include highlights and notes"
msgstr "Vrátane zvýraznení a poznámok"

#: main.lua:411
msgid "Advanced"
msgstr "Rozšírené"

#: main.lua:415
msgid "Disconnect this device"
msgstr "Odpojiť toto zariadenie"

#: main.lua:420
msgid "Disconnect this device from CWNG? Downloaded books stay on it; covers of books you have not downloaded stay until you connect again."
msgstr "Odpojiť toto zariadenie od CWNG? Stiahnuté knihy v ňom zostanú; obálky nestiahnutých kníh zostanú, kým sa znova nepripojíte."

#: main.lua:421
msgid "Disconnect"
msgstr "Odpojiť"

#: main.lua:430
msgid "Plugin version: %1"
msgstr "Verzia pluginu: %1"

#: main.lua:434
msgid ""
"CWNG library plugin\n"
"Version: %1\n"
"\n"
"Keeps this device's library, reading position, read status and highlights in step with Calibre-Web NextGen."
msgstr ""
"Plugin knižnice CWNG\n"
"Verzia: %1\n"
"\n"
"Udržiava knižnicu tohto zariadenia, pozíciu čítania, stav prečítania a zvýraznenia v súlade s Calibre-Web NextGen."

#: main.lua:446
msgid "Start on the library home"
msgstr "Spúšťať na domovskej obrazovke knižnice"

#: main.lua:447
msgid "Show your books by Reading, Recent, Shelves, Authors and Series instead of KOReader's file browser. The file browser is always one tap away (menu, Browse files)."
msgstr "Zobrazí vaše knihy podľa kategórií Čítam, Nedávne, Police, Autori a Série namiesto prehliadača súborov KOReadera. Prehliadač súborov je vždy na jedno ťuknutie (ponuka, Prechádzať súbory)."

#: main.lua:460
msgid "Set NextGen Server"
msgstr "Nastaviť server NextGen"

#: main.lua:465
msgid "NextGen Server Address"
msgstr "Adresa servera NextGen"

#: main.lua:475
msgid "Logout"
msgstr "Odhlásiť sa"

#: main.lua:476 main.lua:735
msgid "Login"
msgstr "Prihlásiť sa"

#: main.lua:493
msgid "Document matching method"
msgstr "Spôsob párovania dokumentov"

#: main.lua:494
msgid "Binary matches file contents. Filename matches the exact name, including its extension, without reading file contents. Use Filename for sideloaded copies whose bytes changed during conversion or metadata editing, keeping the same library or download name. Renamed files will not match; different books with identical names can match each other. Already queued updates keep the identity they were captured with."
msgstr "Binárne porovnáva obsah súboru. Podľa názvu porovnáva presný názov vrátane prípony bez čítania obsahu súboru. Podľa názvu použite pre ručne nahraté kópie, ktorých bajty sa zmenili pri konverzii alebo úprave metadát, ale majú rovnaký názov v knižnici alebo pri stiahnutí. Premenované súbory sa nespárujú; rôzne knihy s rovnakým názvom sa môžu spárovať navzájom. Už zaradené aktualizácie si ponechajú identitu, s ktorou boli zachytené."

#: main.lua:497
msgid "Binary: match file contents"
msgstr "Binárne: porovnať obsah súborov"

#: main.lua:503
msgid "Filename: match exact names"
msgstr "Podľa názvu: porovnať presné názvy"

#: main.lua:512
msgid "Periodically sync every # pages (%1)"
msgstr "Pravidelne synchronizovať každých # strán (%1)"

#: main.lua:519
msgid ""
"This value determines how many page turns it takes to update book progress.\n"
"If set to 0, updating progress based on page turns will be disabled."
msgstr ""
"Táto hodnota určuje, po koľkých otočeniach strany sa aktualizuje postup v knihe.\n"
"Ak je nastavená na 0, aktualizácia postupu podľa otočených strán je vypnutá."

#: main.lua:526
msgid "Set"
msgstr "Nastaviť"

#: main.lua:527
msgid "Number of pages before update"
msgstr "Počet strán pred aktualizáciou"

#: main.lua:539
msgid "Sync behavior"
msgstr "Správanie synchronizácie"

#: main.lua:544
msgid "Sync to a newer state (%1)"
msgstr "Synchronizovať na novší stav (%1)"

#: main.lua:548 main.lua:582
msgid "Silently"
msgstr "Potichu"

#: main.lua:578
msgid "Sync to an older state (%1)"
msgstr "Synchronizovať na starší stav (%1)"

#: main.lua:614
msgid "Push progress from this device now"
msgstr "Odoslať postup z tohto zariadenia teraz"

#: main.lua:623
msgid "Pull progress from other devices now"
msgstr "Načítať postup z iných zariadení teraz"

#: main.lua:633
msgid "Report books on this device now"
